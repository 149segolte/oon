schema = "Config";

overlay defaults = {
    set .profile = {
        name = "Ada";
        active = true;
    };

    .coordinates = (41.8781; -87.6298;);
    .mode = "debug";
};

overlay workstation = {
    merge .packages = [
        {
            name = "ruff";
            version = 1;
            metadata.channel = "stable";
        };
    ];

    if .profile.active and .packages.0.version > 0 {
        .labels.owner = .profile.name;
    } else {
        reset .labels;
    };

    for i in .packages {
        merge .labels = {
            last-package = .packages.i.name;
        };
    };
};

